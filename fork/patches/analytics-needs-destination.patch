From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: shadeydev <233503709+shadeydev@users.noreply.github.com>
Date: Fri, 27 Nov 2026 03:41:44 -0600
Subject: [PATCH] server: analytics stays off while it has no key or host to
 send to

Intent: with analytics turned on but an empty key or host, the server would still record events and post each batch to an empty host, which fails on the machine and is retried until the batch is dropped. Treat an empty key or host as analytics off, so nothing is recorded or sent. Today that is this build's default: fork/apply.ts blanks upstream's key and host. With T3CODE_TELEMETRY_KEY and T3CODE_TELEMETRY_HOST both set in the server's environment, analytics works as upstream's does (still only when it is turned on), with no code change.

Kind: fork-only. Drop it if upstream adds the same guard. It stays useful after this build gets a default destination of its own: either value can still be emptied in the environment.

Check: apps/server/src/telemetry/AnalyticsService.destination.test.ts: "records and sends nothing while the key or the host is empty" (with both set, one event is recorded and one batch is sent; with either empty, none).
Fork-Patch: analytics-needs-destination.patch
Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>

diff --git a/apps/server/src/telemetry/AnalyticsService.destination.test.ts b/apps/server/src/telemetry/AnalyticsService.destination.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c21a97be1d49c1e19842f2db04241af08775144b
--- /dev/null
+++ b/apps/server/src/telemetry/AnalyticsService.destination.test.ts
@@ -0,0 +1,73 @@
+import * as NodeCrypto from "@effect/platform-node/NodeCrypto";
+import * as NodeHttpServer from "@effect/platform-node/NodeHttpServer";
+import * as NodeServices from "@effect/platform-node/NodeServices";
+import { assert, it } from "@effect/vitest";
+import * as ConfigProvider from "effect/ConfigProvider";
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+import * as HttpServer from "effect/http/HttpServer";
+import * as HttpServerRequest from "effect/http/HttpServerRequest";
+import * as HttpServerResponse from "effect/http/HttpServerResponse";
+import * as HostProcess from "@t3tools/shared/HostProcess";
+
+import * as ServerConfig from "../config.ts";
+import * as ManagedPolicy from "../policy/ManagedPolicy.ts";
+import * as AnalyticsService from "./AnalyticsService.ts";
+
+const recordOneEvent = (destination: { readonly key: string; readonly host: string }) =>
+  Effect.gen(function* () {
+    const sentPaths: Array<string> = [];
+    const layerBatchServer = HttpServer.serve(
+      Effect.gen(function* () {
+        const request = yield* HttpServerRequest.HttpServerRequest;
+        sentPaths.push(request.url);
+        return HttpServerResponse.jsonUnsafe({});
+      }),
+    );
+    const layerRuntime = AnalyticsService.layer.pipe(
+      Layer.provideMerge(
+        ServerConfig.ServerConfig.layerTest(process.cwd(), { prefix: "t3-telemetry-nodest-" }),
+      ),
+      Layer.provide(
+        ConfigProvider.layer(
+          ConfigProvider.fromUnknown({
+            T3CODE_TELEMETRY_ENABLED: true,
+            T3CODE_TELEMETRY_KEY: destination.key,
+            T3CODE_TELEMETRY_HOST: destination.host,
+          }),
+        ),
+      ),
+      Layer.provide(
+        Layer.mergeAll(
+          Layer.succeed(HostProcess.Platform, "linux"),
+          Layer.succeed(HostProcess.Architecture, "arm64"),
+          ManagedPolicy.layerTest(),
+        ),
+      ),
+      Layer.provideMerge(NodeHttpServer.layerTest),
+    );
+
+    const recorded = yield* Effect.gen(function* () {
+      yield* Layer.launch(layerBatchServer).pipe(Effect.forkScoped);
+      const analytics = yield* AnalyticsService.AnalyticsService;
+      const accepted = yield* analytics.record("test.destination", { index: 1 });
+      yield* analytics.flush;
+      return accepted;
+    }).pipe(Effect.provide(layerRuntime));
+
+    return { recorded, sent: sentPaths.length };
+  });
+
+it.layer(Layer.mergeAll(NodeServices.layer, NodeCrypto.layer))("Analytics destination", (it) => {
+  it.effect("records and sends nothing while the key or the host is empty", () =>
+    Effect.gen(function* () {
+      const both = yield* recordOneEvent({ key: "phc_test_key", host: "http://localhost" });
+      const noHost = yield* recordOneEvent({ key: "phc_test_key", host: "" });
+      const noKey = yield* recordOneEvent({ key: "", host: "http://localhost" });
+
+      assert.deepEqual(both, { recorded: true, sent: 1 });
+      assert.deepEqual(noHost, { recorded: false, sent: 0 });
+      assert.deepEqual(noKey, { recorded: false, sent: 0 });
+    }),
+  );
+});
diff --git a/apps/server/src/telemetry/AnalyticsService.ts b/apps/server/src/telemetry/AnalyticsService.ts
index 160c721e85afe6b3a8a02e286e5398dd5c601454..3e754c5b19e8685df72f49145fc0b6cd88aa47fb 100644
--- a/apps/server/src/telemetry/AnalyticsService.ts
+++ b/apps/server/src/telemetry/AnalyticsService.ts
@@ -157,9 +157,11 @@ export const make = Effect.gen(function* () {
   // A managed policy can switch analytics off over the environment, never on.
   const policyAllows =
     ManagedPolicy.deniedBy(yield* ManagedPolicy.ManagedPolicy, "telemetry") === undefined;
+  // Without a key and a host there is nowhere to send, so analytics is off.
+  const hasDestination = telemetryConfig.ingestKey !== "" && telemetryConfig.ingestHost !== "";
   // A cached PATH does not establish consent from the current login shell.
   const telemetryEnabled = Effect.suspend(() => {
-    if (!enabledAtStartup || !policyAllows || isDoNotTrackSet(hostEnvironment))
+    if (!enabledAtStartup || !policyAllows || !hasDestination || isDoNotTrackSet(hostEnvironment))
       return Effect.succeed(false);
     if (!awaitingShellConsent) return Effect.succeed(true);
     if (hostEnvironment.T3CODE_DESKTOP_SHELL_DISCOVERY_PENDING === "1")
