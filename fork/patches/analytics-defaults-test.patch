From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: shadeydev <233503709+shadeydev@users.noreply.github.com>
Date: Fri, 27 Nov 2026 04:01:17 -0600
Subject: [PATCH] server: a test that this build's analytics defaults point at
 its own ingest server

Intent: fork/apply.ts gives this build its own analytics defaults: on unless the host is a CI runner or DO_NOT_TRACK is set, sent to https://ingest.shipdifferent.dev with the build's public app key. This test starts the analytics service with no settings at all and checks the one request it makes: that address, that key. It also checks nothing is sent from a CI runner or with DO_NOT_TRACK. It fails if that request goes to any other address or carries any other key, for instance because a sync left upstream's values as the service's defaults. It compares what is sent, not where the service read it from, and it covers the service with no settings; a server whose environment sets its own host and key sends there, and the desktop app sends nothing while its shell discovery is pending. Changing where this build's analytics go by default, or switching the default off (fork/identity.json telemetryEnabledByDefault), means changing this test, on purpose.

Kind: fork-only. A test file only; it changes no shipped code.

Check: apps/server/src/telemetry/AnalyticsService.defaults.test.ts: "with no settings, events go to this build's own ingest server and nowhere else" and "with no settings, nothing is sent from a CI runner or with DO_NOT_TRACK".
Fork-Patch: analytics-defaults-test.patch
Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>

diff --git a/apps/server/src/telemetry/AnalyticsService.defaults.test.ts b/apps/server/src/telemetry/AnalyticsService.defaults.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..86f1f837ecc9e4b63bbfb3d69533ff7c871a7fc6
--- /dev/null
+++ b/apps/server/src/telemetry/AnalyticsService.defaults.test.ts
@@ -0,0 +1,70 @@
+import * as NodeCrypto from "@effect/platform-node/NodeCrypto";
+import * as NodeServices from "@effect/platform-node/NodeServices";
+import { assert, it } from "@effect/vitest";
+import * as ConfigProvider from "effect/ConfigProvider";
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+import * as HttpClient from "effect/http/HttpClient";
+import * as HttpClientResponse from "effect/http/HttpClientResponse";
+import * as HostProcess from "@t3tools/shared/HostProcess";
+
+import * as ServerConfig from "../config.ts";
+import * as ManagedPolicy from "../policy/ManagedPolicy.ts";
+import * as AnalyticsService from "./AnalyticsService.ts";
+
+/** One event from a server with no analytics settings at all, in the given host environment. */
+const sendWithDefaults = (hostEnvironment: NodeJS.ProcessEnv) =>
+  Effect.gen(function* () {
+    const sent: Array<{ readonly url: string; readonly apiKey: unknown }> = [];
+    const client = HttpClient.make((request) =>
+      Effect.sync(() => {
+        const body =
+          request.body._tag === "Uint8Array"
+            ? (JSON.parse(new TextDecoder().decode(request.body.body)) as { api_key?: unknown })
+            : {};
+        sent.push({ url: request.url, apiKey: body.api_key });
+        return HttpClientResponse.fromWeb(request, new Response(null, { status: 204 }));
+      }),
+    );
+    const layerRuntime = AnalyticsService.layer.pipe(
+      Layer.provideMerge(
+        ServerConfig.ServerConfig.layerTest(process.cwd(), { prefix: "t3-telemetry-defaults-" }),
+      ),
+      Layer.provide(ConfigProvider.layer(ConfigProvider.fromUnknown({}))),
+      Layer.provide(
+        Layer.mergeAll(
+          Layer.succeed(HostProcess.Platform, "linux"),
+          Layer.succeed(HostProcess.Architecture, "arm64"),
+          Layer.succeed(HttpClient.HttpClient, client),
+          ManagedPolicy.layerTest(),
+        ),
+      ),
+    );
+
+    yield* Effect.gen(function* () {
+      const analytics = yield* AnalyticsService.AnalyticsService;
+      yield* analytics.record("test.defaults", { index: 1 });
+      yield* analytics.flush;
+    }).pipe(
+      Effect.provide(layerRuntime),
+      Effect.provideService(HostProcess.Environment, hostEnvironment),
+    );
+    return sent;
+  });
+
+it.layer(Layer.mergeAll(NodeServices.layer, NodeCrypto.layer))("Analytics defaults", (it) => {
+  it.effect("with no settings, events go to this build's own ingest server and nowhere else", () =>
+    Effect.gen(function* () {
+      assert.deepEqual(yield* sendWithDefaults({}), [
+        { url: "https://ingest.shipdifferent.dev/batch/", apiKey: "shipdifferent-app-1" },
+      ]);
+    }),
+  );
+
+  it.effect("with no settings, nothing is sent from a CI runner or with DO_NOT_TRACK", () =>
+    Effect.gen(function* () {
+      assert.deepEqual(yield* sendWithDefaults({ CI: "true" }), []);
+      assert.deepEqual(yield* sendWithDefaults({ DO_NOT_TRACK: "1" }), []);
+    }),
+  );
+});
